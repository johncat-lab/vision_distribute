<?xml version="1.0"?>
<opencv_storage>
<!-- 日志级别: trace, debug, info, warn, error, fatal -->
<log_level>debug</log_level>

<!-- 输出方式: console, file, both -->
<log_output>both</log_output>

<!-- 日志目录 -->
<log_dir>./logs</log_dir>

<!-- 日志文件名（可选，不设置则自动生成带时间戳的文件名） -->
<log_file></log_file>

<!-- 是否启用时间戳 -->
<enable_timestamp>1</enable_timestamp>

<!-- 是否启用线程ID -->
<enable_thread_id>0</enable_thread_id>

<!-- 最大文件大小（MB） -->
<max_file_size_mb>10</max_file_size_mb>

<!-- 最大保留文件数 -->
<max_files>5</max_files>
</opencv_storage>