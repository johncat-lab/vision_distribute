<?xml version="1.0"?>
<opencv_storage>
<!-- ===== ROS2 传输配置 ===== -->
<transport>ros2</transport>

<!-- ROS2 domain ID (0~101)，用于隔离不同 ROS2 网络 -->
<!-- 同一 domain 内的节点才能互相发现和通信 -->
<domain_id>0</domain_id>

<!-- ROS2 不使用 base_port，保留为默认值即可 -->
<base_port>5550</base_port>

<!-- 帧发布/订阅 topic (camera_node -> detector_node) -->
<!-- ROS2 topic 命名遵循 ROS2 规范: 小写字母+下划线 -->
<topic_frame>vision/frame</topic_frame>

<!-- 检测结果发布/订阅 topic (detector_node -> comm_node) -->
<topic_detection>vision/detection</topic_detection>
</opencv_storage>
