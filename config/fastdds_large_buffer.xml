<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <!-- 共享内存传输：同一主机上的进程间通信无消息大小限制 -->
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>SHM</transport_id>
            <type>SHM</type>
            <maxMessageSize>67108864</maxMessageSize> <!-- 64 MB -->
            <segment_size>67108864</segment_size>     <!-- 64 MB -->
        </transport_descriptor>
        <transport_descriptor>
            <transport_id>LargeUDPv4</transport_id>
            <type>UDPv4</type>
            <sendBufferSize>16777216</sendBufferSize>
            <receiveBufferSize>16777216</receiveBufferSize>
            <non_blocking_send>true</non_blocking_send>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="default_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>SHM</transport_id>
                <transport_id>LargeUDPv4</transport_id>
            </userTransports>
            <useBuiltinTransports>true</useBuiltinTransports>
        </rtps>
    </participant>

</profiles>
